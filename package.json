{
  "name": "super-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "styles": "node scripts/preview-styles.mjs",
    "predev": "npm run styles",
    "prebuild": "node scripts/merge-integrations.mjs && node scripts/verify-assessments.mjs && npm run styles && node scripts/export-catalog.mjs",
    "catalog": "node scripts/build-catalog.mjs && node scripts/merge-integrations.mjs && node scripts/export-catalog.mjs",
    "format": "prettier --write src/main.tsx src/previews.tsx src/preview-frame.tsx src/catalog.ts src/library-image.tsx src/lib src/adapters src/styles.css scripts tests vite.config.ts",
    "classify": "node scripts/classify-components.mjs",
    "start": "node server/index.mjs",
    "search:server": "node server/index.mjs",
    "search:index": "node --input-type=module -e \"import('./server/retrieval.mjs').then(m => m.prepareIndex()).then(() => console.log('Semantic index ready'))\"",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm run check:release && npm test && npm run build",
    "mcp:smoke": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@daypicker/react": "^10.0.1",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@paper-design/shaders-react": "^0.0.81",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@squircle-js/react": "^1.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/flubber": "^0.4.0",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "figma-squircle": "^1.1.0",
    "flubber": "^0.4.2",
    "framer-motion": "^13.4.0",
    "glimm": "^0.3.1",
    "iconoir-react": "^7.12.1",
    "img-fx": "^0.5.1",
    "input-otp": "^1.5.0",
    "liquid-gooey": "^0.2.1",
    "liveline": "^0.0.7",
    "lucide-react": "^0.468.0",
    "metal-fx": "^2.0.10",
    "motion": "^12.0.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.4.0",
    "react": "^19.1.0",
    "react-apple-emojis": "^3.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.4",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.8.0",
    "shadow-plugin": "^2.1.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.0",
    "thinking-orbs": "^0.3.1",
    "three": "^0.186.0",
    "vaul": "^1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.7",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "description": "Discover, compare, and try original React components with problem-based semantic search.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/blosmo/super-UI.git"
  },
  "bugs": {
    "url": "https://github.com/blosmo/super-UI/issues"
  },
  "homepage": "https://github.com/blosmo/super-UI#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "semantic-search",
    "jev",
    "shadcn"
  ]
}
