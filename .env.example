# Copy to .env.local. Optional: enables Jev ranking; never use a VITE_ prefix.
TYPESAFE_API_KEY=
# Conservative daily cap for server-side search API calls.
SEARCH_DAILY_BUDGET_USD=1
# Vercel paid ranking also needs a shared Redis budget (server-only).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Server defaults (also configurable in the process environment).
# HOST=127.0.0.1
# PORT=4174
# Public HTTPS origin for hosted MCP access and absolute component links.
# PUBLIC_URL=https://your-component-domain.example
